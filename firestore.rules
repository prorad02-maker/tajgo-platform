rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || userData(request.auth.uid).role == 'admin'
        );
    }

    function isApprovedCourier() {
      let user = userData(request.auth.uid);
      return signedIn()
        && user.role == 'courier'
        && user.courierStatus == 'approved'
        && user.roles is list
        && user.roles.hasAny(['courier']);
    }

    function isWaitingStatus(status) {
      return status in ['draft', 'waiting', 'waitingOffers'];
    }

    function validLocation(location) {
      return location is latlng
        && location.latitude >= -90
        && location.latitude <= 90
        && location.longitude >= -180
        && location.longitude <= 180;
    }

    function safeOwnUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'name',
        'photoUrl',
        'city',
        'language',
        'updatedAt'
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.role == resource.data.role
      && request.resource.data.roles == resource.data.roles
      && request.resource.data.courierStatus == resource.data.courierStatus
      && request.resource.data.updatedAt == request.time;
    }

    function safeCourierApplicationUserSync(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let nextStatus = request.resource.data.courierStatus;
      let nextApplication = getAfter(
        /databases/$(database)/documents/courier_applications/$(uid)
      ).data;
      return owner(uid)
        && changed.hasOnly([
          'courierStatus',
          'targetRole',
          'lastMode',
          'updatedAt'
        ])
        && nextStatus in ['draft', 'pending']
        && request.resource.data.targetRole == 'courier'
        && request.resource.data.lastMode == 'customer'
        && nextApplication.status == nextStatus
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if owner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if isAdmin()
        || (owner(uid) && safeOwnUserUpdate())
        || safeCourierApplicationUserSync(uid);
      allow delete: if false;
    }

    function safeOwnerApplicationCreate(uid) {
      let next = request.resource.data;
      return owner(uid)
        && next.uid == uid
        && next.status in ['draft', 'pending']
        && next.keys().hasOnly([
          'uid',
          'displayName',
          'name',
          'phoneNumber',
          'status',
          'currentStep',
          'birthDate',
          'profilePhotoUrl',
          'transport',
          'documentType',
          'documentNumber',
          'documentPhotoUrl',
          'transportPhotoUrl',
          'city',
          'workDistrict',
          'availability',
          'termsAccepted',
          'dataConsent',
          'storageEnabled',
          'verificationMethod',
          'submittedAt',
          'createdAt',
          'updatedAt'
        ])
        && next.createdAt == request.time
        && next.updatedAt == request.time;
    }

    function safeOwnerApplicationUpdate(uid) {
      let next = request.resource.data;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return owner(uid)
        && next.uid == uid
        && resource.data.status in ['draft', 'rejected']
        && next.status in ['draft', 'pending']
        && changed.hasOnly([
          'displayName',
          'name',
          'phoneNumber',
          'status',
          'currentStep',
          'birthDate',
          'profilePhotoUrl',
          'transport',
          'documentType',
          'documentNumber',
          'documentPhotoUrl',
          'transportPhotoUrl',
          'city',
          'workDistrict',
          'availability',
          'termsAccepted',
          'dataConsent',
          'storageEnabled',
          'verificationMethod',
          'submittedAt',
          'updatedAt'
        ])
        && next.updatedAt == request.time;
    }

    match /courier_applications/{uid} {
      allow get: if owner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || safeOwnerApplicationCreate(uid);
      allow update: if isAdmin() || safeOwnerApplicationUpdate(uid);
      allow delete: if false;
    }

    function safePresenceUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        'isOnline',
        'online',
        'location',
        'locationUpdatedAt',
        'locationAccuracy',
        'heading',
        'speed',
        'updatedAt'
      ])
      && request.resource.data.isOnline is bool
      && request.resource.data.online is bool
      && request.resource.data.isOnline == request.resource.data.online
      && (
        !changed.hasAny(['location'])
        || validLocation(request.resource.data.location)
      )
      && (
        !changed.hasAny(['locationAccuracy'])
        || (
          request.resource.data.locationAccuracy is number
          && request.resource.data.locationAccuracy >= 0
          && request.resource.data.locationAccuracy <= 200
        )
      )
      && (
        !changed.hasAny(['heading'])
        || (
          request.resource.data.heading is number
          && request.resource.data.heading >= 0
          && request.resource.data.heading <= 360
        )
      )
      && (
        !changed.hasAny(['speed'])
        || (
          request.resource.data.speed is number
          && request.resource.data.speed >= 0
          && request.resource.data.speed <= 80
        )
      )
      && (
        !changed.hasAny(['locationUpdatedAt'])
        || request.resource.data.locationUpdatedAt == request.time
      )
      && request.resource.data.updatedAt == request.time;
    }

    match /couriers/{uid} {
      allow get: if owner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (
          owner(uid)
          && isApprovedCourier()
          && safePresenceUpdate()
        );
      allow delete: if false;
    }

    function validPublicCourierShape() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'displayName',
        'name',
        'isOnline',
        'online',
        'rating',
        'transport',
        'location',
        'locationUpdatedAt',
        'locationAccuracy',
        'heading',
        'speed',
        'updatedAt'
      ]);
    }

    function safePublicCourierRead() {
      return resource.data.keys().hasOnly([
        'uid',
        'displayName',
        'name',
        'isOnline',
        'online',
        'rating',
        'transport',
        'location',
        'locationUpdatedAt',
        'locationAccuracy',
        'heading',
        'speed',
        'updatedAt'
      ]);
    }

    match /courier_public/{uid} {
      allow read: if signedIn() && safePublicCourierRead();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (
          owner(uid)
          && isApprovedCourier()
          && validPublicCourierShape()
          && safePresenceUpdate()
        );
      allow delete: if false;
    }

    function orderOwner() {
      return signedIn() && resource.data.customerId == request.auth.uid;
    }

    function assignedCourier() {
      return isApprovedCourier()
        && resource.data.get('confirmationCode', null) == null
        && (
          resource.data.courierId == request.auth.uid
          || resource.data.selectedCourierId == request.auth.uid
        );
    }

    function visibleWaitingOrder() {
      return isApprovedCourier()
        && isWaitingStatus(resource.data.status)
        && resource.data.get('confirmationCode', null) == null
        && resource.data.get('isTestOrder', false) != true;
    }

    match /orders/{orderId} {
      allow get: if orderOwner()
        || assignedCourier()
        || visibleWaitingOrder()
        || isAdmin();
      allow list: if orderOwner()
        || assignedCourier()
        || visibleWaitingOrder()
        || isAdmin();

      // Authoritative Functions use Admin SDK and bypass Rules. No mobile
      // client may create, assign, price, transition or complete an order.
      allow create, update, delete: if false;

      match /offers/{courierId} {
        function parentOrder() {
          return get(
            /databases/$(database)/documents/orders/$(orderId)
          ).data;
        }

        allow get, list: if isAdmin()
          || (
            signedIn()
            && parentOrder().customerId == request.auth.uid
          )
          || (
            isApprovedCourier()
            && courierId == request.auth.uid
          );
        allow create, update, delete: if false;
      }
    }

    match /order_customer_codes/{orderId} {
      allow get: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || isAdmin()
        );
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Hash, salt and attempt counters are backend-only, including for admin.
    match /order_secrets/{orderId} {
      allow read, write: if false;
    }

    // Callable idempotency results are returned by Functions, never read by
    // mobile clients.
    match /command_results/{commandId} {
      allow read, write: if false;
    }

    function publishedPartner() {
      return resource.data.isActive == true
        && resource.data.get('isPublished', true) == true
        && resource.data.get('isTest', false) != true
        && resource.data.get('isPreview', false) != true;
    }

    match /partners/{partnerId} {
      allow get, list: if isAdmin() || (signedIn() && publishedPartner());
      allow create, update: if isAdmin()
        && request.resource.data.get('isPreview', false) != true;
      allow delete: if isAdmin();
    }

    function publicProduct(partnerId) {
      let partner = get(
        /databases/$(database)/documents/partners/$(partnerId)
      ).data;
      return resource.data.get('hidden', false) == false
        && resource.data.get('isAvailable', true) == true
        && resource.data.get('isPublished', true) == true
        && resource.data.get('isTest', false) != true
        && partner.isActive == true
        && partner.get('isTest', false) != true
        && partner.get('isPreview', false) != true;
    }

    match /products/{productId} {
      allow get, list: if isAdmin()
        || (
          signedIn()
          && publicProduct(resource.data.partnerId)
        );
      allow create, update, delete: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
