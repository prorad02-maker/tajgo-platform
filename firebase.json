{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "tajgo-4fcd0",
          "appId": "1:784873463457:android:0ac2e36af2d8c1a0c91ae0",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "tajgo-4fcd0",
          "configurations": {
            "android": "1:784873463457:android:0ac2e36af2d8c1a0c91ae0",
            "ios": "1:784873463457:ios:42381eb986ce1b77c91ae0",
            "macos": "1:784873463457:ios:42381eb986ce1b77c91ae0",
            "web": "1:784873463457:web:ee2ac3d85f6fe22ac91ae0",
            "windows": "1:784873463457:web:cab93b24fc11e9d1c91ae0"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" run build",
      "npm --prefix \"$RESOURCE_DIR\" test"
    ]
  },
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "predeploy": [
      "node scripts/version_website_assets.mjs",
      "node scripts/check_website.mjs"
    ],
    "headers": [{
      "regex": "^/([^.]*|.*\\.(html|css|js))$",
      "headers": [{
        "key": "Cache-Control",
        "value": "no-cache, max-age=0, must-revalidate"
      }]
    }],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
